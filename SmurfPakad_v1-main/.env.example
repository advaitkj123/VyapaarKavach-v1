# SmurfPakad Environment Variables
# ==================================
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to git.

# ─── Backend ──────────────────────────────────────────────
# JWT secret key (generate: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=jwt-key-here

# ─── IBM watsonx.ai ───────────────────────────────────────
# Get from: https://cloud.ibm.com/iam/apikeys
IBM_WATSONX_API_KEY=your-ibm-cloud-api-key

# Get from: https://dataplatform.cloud.ibm.com/projects
IBM_WATSONX_PROJECT_ID=your-watsonx-project-id

# Region URL (default: Dallas)
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Model ID (free tier supported)
IBM_WATSONX_MODEL_ID=ibm/granite-3-3-8b-instruct

# ─── Frontend ─────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000

# ─── Database (Optional - defaults to SQLite) ─────────────
# DATABASE_URL=postgresql://user:password@localhost:5432/smurfpakad

# ─── LLM Fallback: Groq (FREE — no credit card, just email signup) ───────────
# Sign up free at: https://console.groq.com
# Creates API key immediately — no card, no waiting, 14,400 tokens/min free
# Model: Llama 3.1 70B (comparable quality to IBM Granite)
# Used automatically when IBM watsonx.ai is not configured
GROQ_API_KEY=groq-key-here

# ─── IBM Db2 on Cloud (Optional — free tier, 200MB) ──────────────────────────
# Get from: https://cloud.ibm.com/catalog/services/db2 (select Lite plan)
# After creating: Service Credentials → New Credential → copy connection.db2
# Format: DATABASE=BLUDB;HOSTNAME=<host>;PORT=50001;PROTOCOL=TCPIP;UID=<u>;PWD=<p>;Security=SSL;
# IBM_DB2_DSN=DATABASE=BLUDB;HOSTNAME=...

# ─── Debug ────────────────────────────────────────────────
DEBUG=False

# ─── OAuth (Google) ─────────────────────────────────────────────
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID = key-here
GOOGLE_CLIENT_SECRET=key-here

# ─── LLM Fallback: Groq (FREE — no credit card) ─────────────────
# Sign up free at: https://console.groq.com
GROQ_API_KEY=groq-key-here